{
  "name": "haythive",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @haythive/web dev",
    "dev:api": "pnpm --filter @haythive/api dev",
    "dev:web": "pnpm --filter @haythive/web dev",
    "api:generate": "pnpm --filter @haythive/web api:generate",
    "build": "pnpm -r run build",
    "build:api": "pnpm --filter @haythive/api build",
    "build:web": "pnpm --filter @haythive/web build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @haythive/api prisma:migrate",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "unrs-resolver"
    ]
  }
}
