{
  "openapi": "3.0.0",
  "paths": {
    "/auth/login": {
      "post": {
        "description": "Validates operator credentials and sets an httpOnly session cookie used by subsequent API calls.",
        "operationId": "postAuthLogin",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginDto" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponseDto" }
              }
            }
          },
          "401": { "description": "Invalid email or password." }
        },
        "summary": "Sign in with email and password",
        "tags": ["Auth"]
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Clears the session cookie so the browser is no longer authenticated.",
        "operationId": "postAuthLogout",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "ok": { "type": "boolean", "example": true } }
                }
              }
            }
          }
        },
        "summary": "Sign out",
        "tags": ["Auth"]
      }
    },
    "/auth/me": {
      "get": {
        "description": "Returns the authenticated operator from the session cookie.",
        "operationId": "getAuthMe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponseDto" }
              }
            }
          },
          "401": { "description": "Missing or invalid session." }
        },
        "security": [{ "cookie": [] }],
        "summary": "Get current user",
        "tags": ["Auth"]
      }
    },
    "/device/ingest": {
      "post": {
        "description": "Edge/simulator endpoint. Authenticates with device serial + ingest token, updates lastHeartbeatAt and projected dock state, and marks the dock ONLINE.",
        "operationId": "postDeviceIngest",
        "parameters": [
          {
            "name": "x-device-token",
            "required": true,
            "in": "header",
            "schema": { "type": "string" }
          },
          {
            "name": "authorization",
            "required": true,
            "in": "header",
            "schema": { "type": "string" }
          },
          {
            "name": "X-Device-Token",
            "in": "header",
            "description": "Device ingest token issued at provisioning/seed time.",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeviceIngestDto" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceIngestResponseDto"
                }
              }
            }
          },
          "401": { "description": "Invalid serial or ingest token." }
        },
        "summary": "Ingest dock heartbeat and state",
        "tags": ["Device Ingest"]
      }
    },
    "/devices": {
      "get": {
        "description": "Returns registered dock devices for the operator dashboard, including site name and last heartbeat.",
        "operationId": "getDevices",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/DeviceResponseDto" }
                }
              }
            }
          },
          "401": { "description": "Missing or invalid session." }
        },
        "security": [{ "cookie": [] }],
        "summary": "List dock devices",
        "tags": ["Devices"]
      }
    },
    "/devices/{id}/state": {
      "get": {
        "description": "Returns the latest projected dock state: lid, platform, charge, readiness, connectivity, and heartbeat age inputs.",
        "operationId": "getDevicesByIdState",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceStateResponseDto"
                }
              }
            }
          },
          "401": { "description": "Missing or invalid session." },
          "404": { "description": "Device or device state not found." }
        },
        "security": [{ "cookie": [] }],
        "summary": "Get current dock state",
        "tags": ["Devices"]
      }
    },
    "/devices/{id}": {
      "get": {
        "description": "Returns a single dock device by id.",
        "operationId": "getDevicesById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeviceResponseDto" }
              }
            }
          },
          "401": { "description": "Missing or invalid session." },
          "404": { "description": "Device not found." }
        },
        "security": [{ "cookie": [] }],
        "summary": "Get a dock device",
        "tags": ["Devices"]
      }
    },
    "/actuators/commands": {
      "post": {
        "description": "Persists a lid or platform command, validates soft interlocks, marks it SENT, and dispatches it to the edge adapter. The stub edge later ACKs and updates projected dock state.",
        "operationId": "postActuatorsCommands",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateActuatorCommandDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CommandResponseDto" }
              }
            }
          },
          "401": { "description": "Missing or invalid session." },
          "404": { "description": "Device not found." },
          "409": {
            "description": "Interlock rejected the command or device has no state."
          }
        },
        "security": [{ "cookie": [] }],
        "summary": "Dispatch a dock actuator command",
        "tags": ["Actuators"]
      }
    },
    "/actuators/commands/{id}/abort": {
      "post": {
        "description": "Stops an active (PENDING/SENT) lid or platform command, notifies the edge adapter, marks the original command FAILED, records an ACKED ABORT command, and sets moving axes to UNKNOWN.",
        "operationId": "postActuatorsCommandsByIdAbort",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AbortActuatorCommandDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CommandResponseDto" }
              }
            }
          },
          "401": { "description": "Missing or invalid session." },
          "404": { "description": "Command not found." },
          "409": {
            "description": "Command is not active or dock is not moving."
          }
        },
        "security": [{ "cookie": [] }],
        "summary": "Abort an in-progress actuator command",
        "tags": ["Actuators"]
      }
    },
    "/health": {
      "get": {
        "description": "Returns process health and whether the database connection is reachable.",
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponseDto" }
              }
            }
          }
        },
        "summary": "Get API health",
        "tags": ["Health"]
      }
    }
  },
  "info": {
    "title": "HaytHive Dock API",
    "description": "Control plane for the HaytHive dock management MVP: lid, platform, charging, and readiness.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Auth",
      "description": "Operator authentication and session management."
    },
    {
      "name": "Devices",
      "description": "Dock device registry and live projected state."
    },
    {
      "name": "Actuators",
      "description": "Lid and platform actuator commands dispatched to the dock edge."
    },
    {
      "name": "Device Ingest",
      "description": "Edge/simulator heartbeat and dock state ingestion."
    },
    { "name": "Health", "description": "Service and dependency health checks." }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": { "type": "apiKey", "in": "cookie", "name": "haythive_session" }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Operator email address.",
            "example": "operator@haythive.local"
          },
          "password": {
            "type": "string",
            "description": "Account password.",
            "example": "demo",
            "minLength": 1
          }
        },
        "required": ["email", "password"]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "clx0123456789" },
          "email": { "type": "string", "example": "operator@haythive.local" },
          "role": {
            "type": "string",
            "enum": ["OPERATOR", "TECHNICIAN"],
            "example": "OPERATOR"
          }
        },
        "required": ["id", "email", "role"]
      },
      "ReadinessReasonDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "charge" },
          "label": { "type": "string", "example": "Battery charging healthy" },
          "pass": { "type": "boolean", "example": true },
          "detail": { "type": "string", "example": "SOC 86%" }
        },
        "required": ["id", "label", "pass"]
      },
      "DeviceIngestDto": {
        "type": "object",
        "properties": {
          "serial": {
            "type": "string",
            "description": "Dock serial number.",
            "example": "HH-DOCK-001"
          },
          "opState": {
            "type": "string",
            "enum": ["IDLE", "MOVING", "FAULT", "SERVICE"]
          },
          "lid": {
            "type": "string",
            "enum": ["OPEN", "CLOSED", "MOVING", "UNKNOWN"]
          },
          "platform": {
            "type": "string",
            "enum": ["UP", "DOWN", "MOVING", "UNKNOWN"]
          },
          "chargeStatus": {
            "type": "string",
            "enum": ["UNKNOWN", "NOT_CHARGING", "CHARGING", "CHARGED", "FAULT"]
          },
          "socPercent": {
            "type": "number",
            "example": 86,
            "minimum": 0,
            "maximum": 100
          },
          "readiness": { "type": "string", "enum": ["READY", "NOT_READY"] },
          "readinessReasons": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ReadinessReasonDto" }
          },
          "extras": {
            "type": "object",
            "description": "Opaque edge extras (faults, override flags, etc.).",
            "additionalProperties": true
          }
        },
        "required": ["serial"]
      },
      "DeviceIngestResponseDto": {
        "type": "object",
        "properties": {
          "deviceId": { "type": "string" },
          "serial": { "type": "string" },
          "lastHeartbeatAt": { "type": "object", "nullable": true },
          "connectivity": {
            "type": "string",
            "enum": ["ONLINE", "OFFLINE", "DEGRADED"]
          },
          "opState": {
            "type": "string",
            "enum": ["IDLE", "MOVING", "FAULT", "SERVICE"]
          },
          "lid": {
            "type": "string",
            "enum": ["OPEN", "CLOSED", "MOVING", "UNKNOWN"]
          },
          "platform": {
            "type": "string",
            "enum": ["UP", "DOWN", "MOVING", "UNKNOWN"]
          },
          "chargeStatus": {
            "type": "string",
            "enum": ["UNKNOWN", "NOT_CHARGING", "CHARGING", "CHARGED", "FAULT"]
          },
          "socPercent": { "type": "object", "nullable": true },
          "readiness": { "type": "string", "enum": ["READY", "NOT_READY"] },
          "updatedAt": { "type": "string" }
        },
        "required": [
          "deviceId",
          "serial",
          "connectivity",
          "opState",
          "lid",
          "platform",
          "chargeStatus",
          "readiness",
          "updatedAt"
        ]
      },
      "DeviceResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "clxdevice001" },
          "name": { "type": "string", "example": "Lab Dock 1" },
          "serial": { "type": "string", "example": "HH-DOCK-001" },
          "siteName": {
            "type": "object",
            "description": "Site display name when the dock is assigned to a site.",
            "example": "IoTeedom Lab",
            "nullable": true
          },
          "lastHeartbeatAt": {
            "type": "object",
            "description": "ISO-8601 timestamp of the last edge heartbeat.",
            "example": "2026-09-16T10:00:00.000Z",
            "nullable": true
          }
        },
        "required": ["id", "name", "serial"]
      },
      "DeviceStateResponseDto": {
        "type": "object",
        "properties": {
          "deviceId": { "type": "string", "example": "clxdevice001" },
          "connectivity": {
            "type": "string",
            "enum": ["ONLINE", "OFFLINE", "DEGRADED"],
            "example": "ONLINE"
          },
          "opState": {
            "type": "string",
            "enum": ["IDLE", "MOVING", "FAULT", "SERVICE"],
            "example": "IDLE"
          },
          "lid": {
            "type": "string",
            "enum": ["OPEN", "CLOSED", "MOVING", "UNKNOWN"],
            "example": "CLOSED"
          },
          "platform": {
            "type": "string",
            "enum": ["UP", "DOWN", "MOVING", "UNKNOWN"],
            "example": "DOWN"
          },
          "chargeStatus": {
            "type": "string",
            "enum": ["UNKNOWN", "NOT_CHARGING", "CHARGING", "CHARGED", "FAULT"],
            "example": "CHARGING"
          },
          "socPercent": {
            "type": "object",
            "description": "State of charge percent from edge when available.",
            "example": 86,
            "nullable": true
          },
          "readiness": {
            "type": "string",
            "enum": ["READY", "NOT_READY"],
            "example": "NOT_READY"
          },
          "readinessReasons": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ReadinessReasonDto" }
          },
          "lastHeartbeatAt": {
            "type": "object",
            "description": "ISO-8601 timestamp of the last edge heartbeat.",
            "example": "2026-09-16T10:00:00.000Z",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-09-16T10:00:00.000Z"
          }
        },
        "required": [
          "deviceId",
          "connectivity",
          "opState",
          "lid",
          "platform",
          "chargeStatus",
          "readiness",
          "readinessReasons",
          "updatedAt"
        ]
      },
      "CreateActuatorCommandDto": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "description": "Target dock device id.",
            "example": "clxdevice001"
          },
          "type": {
            "type": "string",
            "description": "Actuator command to dispatch to the edge.",
            "enum": [
              "LID_OPEN",
              "LID_CLOSE",
              "PLATFORM_RAISE",
              "PLATFORM_LOWER"
            ],
            "example": "LID_OPEN"
          }
        },
        "required": ["deviceId", "type"]
      },
      "CommandResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "clxcmd001" },
          "deviceId": { "type": "string", "example": "clxdevice001" },
          "type": {
            "type": "string",
            "enum": [
              "LID_OPEN",
              "LID_CLOSE",
              "PLATFORM_RAISE",
              "PLATFORM_LOWER",
              "ABORT"
            ],
            "example": "LID_OPEN"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "SENT", "ACKED", "FAILED", "TIMEOUT"],
            "example": "SENT"
          },
          "actorId": {
            "type": "object",
            "description": "Operator user id that issued the command.",
            "nullable": true
          },
          "message": {
            "type": "object",
            "description": "Human-readable status or error detail.",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "description": "ISO-8601 creation timestamp.",
            "example": "2026-09-16T11:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "description": "ISO-8601 last update timestamp.",
            "example": "2026-09-16T11:00:00.100Z"
          },
          "completedAt": {
            "type": "object",
            "description": "ISO-8601 completion timestamp when terminal.",
            "nullable": true
          }
        },
        "required": [
          "id",
          "deviceId",
          "type",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "AbortActuatorCommandDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "Optional human-readable reason for the abort.",
            "example": "Operator halted motion",
            "maxLength": 500
          }
        }
      },
      "DeviceConnectivitySummaryDto": {
        "type": "object",
        "properties": {
          "online": { "type": "number", "example": 1 },
          "degraded": { "type": "number", "example": 0 },
          "offline": { "type": "number", "example": 0 }
        },
        "required": ["online", "degraded", "offline"]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Overall API health status.",
            "enum": ["ok", "degraded"],
            "example": "ok"
          },
          "database": {
            "type": "string",
            "description": "Database connectivity status.",
            "enum": ["up", "down"],
            "example": "up"
          },
          "devices": {
            "description": "Dock connectivity counts after stale-heartbeat projection.",
            "allOf": [
              { "$ref": "#/components/schemas/DeviceConnectivitySummaryDto" }
            ]
          },
          "timestamp": {
            "type": "string",
            "description": "ISO-8601 timestamp when the check ran.",
            "example": "2026-09-16T09:00:00.000Z"
          }
        },
        "required": ["status", "database", "devices", "timestamp"]
      }
    }
  }
}
