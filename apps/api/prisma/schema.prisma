generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Placeholder model so the initial migration is non-empty.
/// Dock domain models (User, Device, DeviceState, Command, AuditEvent) land in KON-36.
model SchemaMeta {
  id        String   @id @default("haythive-dock")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
